        "connectionString": "DefaultEndpointsProtocol=https;AccountName=...;AccountKey=...;EndpointSuffix=core.windows.net",
        "container": "archiv",
        "tier": "Archive",
        "maxSizeMB": 1024
    },
    "users": [
        {"user": "you@example.com", "password": "$2y$10$your-bcrypt-hash-here", "name": "Your Name", "initials": "YN", "uid": 1000}
